# Auto detect text files and perform LF normalization
* text=auto
*.sh text eol=lf
*.bat text eol=crlf
*.wasm binary
*.bin binary
# Preserve exact artifact bytes covered by runtime/manifest.json.
runtime/* -text
runtime/** -text
# Keep vendored upstream files byte-for-byte identical across checkouts.
vendor/** -text
licenses/three.txt -text
licenses/lucide.txt -text
